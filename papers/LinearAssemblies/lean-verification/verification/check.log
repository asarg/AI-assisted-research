LinearAssemblies.fixed_confidence_regimes (ext : LinearAssemblies.Probability.FiniteAbsorptionLaw)
  (sub : LinearAssemblies.Probability.SubexponentialEquivalence) (bern : LinearAssemblies.Probability.BernsteinLaw)
  (ε δ : ℝ) (hε : 0 < ε) (hε1 : ε ≤ 1 / 2) (hδ : 0 < δ) (hδ1 : δ ≤ 1 / 2) :
  ∃ l1 l2 u,
