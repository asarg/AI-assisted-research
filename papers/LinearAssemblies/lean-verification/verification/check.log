      0 < l2 ∧
        0 < u ∧
          ∀ᶠ (N : ℕ) in Filter.atTop,
            LinearAssemblies.OnePadBounds N ε δ (l1 * Real.log ↑N) (u * Real.log ↑N) ∧
              LinearAssemblies.GeneralBounds N ε δ (l2 * (Real.log ↑N / Real.log (Real.log ↑N)))
                (u * (Real.log ↑N / Real.log (Real.log ↑N)))
