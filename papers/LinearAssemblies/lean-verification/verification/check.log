LinearAssemblies.TwoPad.exact_construction (ext : LinearAssemblies.Probability.FiniteAbsorptionLaw) (b M : ℕ)
  (hb : 2 ≤ b) (hM : 1 ≤ M) :
  ∃ d,
    d.value = M ∧
      (LinearAssemblies.TwoPad.presentation d).system.Haltable LinearAssemblies.twoPad ∧
        (LinearAssemblies.TwoPad.presentation d).system.expectedLength LinearAssemblies.twoPad = ↑M + 1 ∧
          ↑(LinearAssemblies.TwoPad.presentation d).system.cost ≤ 3 * ↑b + 2 * Real.log ↑M / Real.log ↑b + 1 ∧
