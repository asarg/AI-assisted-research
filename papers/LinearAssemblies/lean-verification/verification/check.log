LinearAssemblies.System.accuracy_lower_bound {I : Type} [DecidableEq I] (s : LinearAssemblies.System I)
  (compat : I → I → Prop) [DecidableRel compat] (N : ℕ) (eps : ℝ) (hN : 4 ≤ N) (heps : 0 < eps) (hepsHalf : eps ≤ 1 / 2)
