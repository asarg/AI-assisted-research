LinearAssemblies.Forest.Counts.nonnegative_integer_representation {S : Type} [Fintype S] [DecidableEq S]
  (c : LinearAssemblies.Forest.Counts S) (hh : c.Haltable) (s : S) :
  LinearAssemblies.Forest.NonnegCoeffs c.B ∧
    LinearAssemblies.Forest.NonnegCoeffs (c.H s) ∧
      Polynomial.eval 0 c.B = Polynomial.eval 0 (c.H s) ∧
        1 ≤ Polynomial.eval 0 c.B ∧
          c.B.natDegree ≤ Fintype.card S ∧
            Polynomial.eval 1 c.B ≤ ∏ i, (2 * ↑(c.degree i) - ↑(c.transition i i)) ∧
              Polynomial.eval 1 c.B ≤ ∏ i, 2 * ↑(c.degree i)
LinearAssemblies.System.tile_polynomial_representation {I : Type} [DecidableEq I] (s : LinearAssemblies.System I)
  (compat : I → I → Prop) [DecidableRel compat] (hh : s.Haltable compat) (start : s.TransientState compat) :
  let c := s.absorptionCounts compat;
  LinearAssemblies.Forest.NonnegCoeffs c.B ∧
    LinearAssemblies.Forest.NonnegCoeffs (c.H start) ∧
      Polynomial.eval 0 c.B = Polynomial.eval 0 (c.H start) ∧
        1 ≤ Polynomial.eval 0 c.B ∧
          c.B.natDegree ≤ Fintype.card (s.TransientState compat) ∧
            Polynomial.eval 1 c.B ≤ ∏ i, (2 * ↑(c.degree i) - ↑(c.transition i i)) ∧
              Polynomial.eval 1 c.B ≤ ∏ i, 2 * ↑(c.degree i)
LinearAssemblies.System.general_coefficient_bounds {I : Type} [DecidableEq I] (s : LinearAssemblies.System I)
  (compat : I → I → Prop) [DecidableRel compat] :
  (s.absorptionCounts compat).B.natDegree ≤ s.cost ∧
    Polynomial.eval 1 (s.absorptionCounts compat).B ≤ (2 * ↑s.cost) ^ s.cost
LinearAssemblies.System.onePad_coefficient_bounds {α : Type} [DecidableEq α] (s : LinearAssemblies.System (Option α)) :
  (s.absorptionCounts LinearAssemblies.onePad).B.natDegree ≤ s.cost ∧
    Polynomial.eval 1 (s.absorptionCounts LinearAssemblies.onePad).B ≤ 2 ^ s.cost
