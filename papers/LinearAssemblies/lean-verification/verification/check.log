LinearAssemblies.Probability.SubexponentialEquivalence : Prop
def LinearAssemblies.Probability.SubexponentialEquivalence : Prop :=
∃ C,
  1 ≤ C ∧
    ∀ (p X : ℕ → ℝ) (K : ℝ),
      (∀ (n : ℕ), 0 ≤ p n) →
        HasSum p 1 →
          0 < K →
            (∀ (u : ℝ), 0 ≤ u → LinearAssemblies.Probability.magnitudeTail p X u ≤ 2 * Real.exp (-u / K)) →
              (Summable fun n => p n * Real.exp (|X n| / (C * K))) ∧ ∑' (n : ℕ), p n * Real.exp (|X n| / (C * K)) ≤ 2
LinearAssemblies.Probability.BernsteinLaw : Prop
def LinearAssemblies.Probability.BernsteinLaw : Prop :=
∃ c,
  0 < c ∧
    ∀ (bs : List LinearAssemblies.Probability.BernsteinInput) (V B t : ℝ),
      (∀ b ∈ bs, b.Valid) →
        0 < V →
          0 < B →
            0 < t →
              (List.map (fun b => b.scale ^ 2) bs).sum ≤ V →
                (∀ b ∈ bs, b.scale ≤ B) →
                  LinearAssemblies.Probability.deviation
                      (LinearAssemblies.Probability.independentSum
                        (List.map LinearAssemblies.Probability.BernsteinInput.mass bs))
                      (List.map LinearAssemblies.Probability.BernsteinInput.mean bs).sum t ≤
                    2 * Real.exp (-c * min (t ^ 2 / V) (t / B))
LinearAssemblies.Probability.block_concentration (sub : LinearAssemblies.Probability.SubexponentialEquivalence)
  (bern : LinearAssemblies.Probability.BernsteinLaw) :
  ∃ a,
    0 < a ∧
      ∀ (bs : List LinearAssemblies.Probability.BlockLaw) (V B t : ℝ),
        0 < V →
          0 < B →
            0 < t →
              (List.map (fun b => ↑b.mean ^ 2) bs).sum ≤ V →
                (∀ b ∈ bs, ↑b.mean ≤ B) →
                  LinearAssemblies.Probability.deviation
                      (LinearAssemblies.Probability.independentSum
                        (List.map LinearAssemblies.Probability.BlockLaw.mass bs))
                      (List.map (fun b => ↑b.mean) bs).sum t ≤
                    2 * Real.exp (-a * min (t ^ 2 / V) (t / B))
LinearAssemblies.onePad_concentrated_upper (ext : LinearAssemblies.Probability.FiniteAbsorptionLaw)
  (sub : LinearAssemblies.Probability.SubexponentialEquivalence) (bern : LinearAssemblies.Probability.BernsteinLaw) :
  ∃ C,
    0 < C ∧
      ∀ (N : ℕ) (ε δ : ℝ),
        2 ≤ N →
          0 < ε →
            ε ≤ 1 / 2 →
              0 < δ →
                δ ≤ 1 / 2 →
                  ∃ b,
                    b.block.p.system.Concentrated LinearAssemblies.onePad (↑N) ε δ ∧
                      ↑b.block.cost ≤
                        C * ↑(LinearAssemblies.Concentration.budgetR N ε δ) *
                          Real.log (1 + ↑N / ↑(LinearAssemblies.Concentration.budgetR N ε δ))
LinearAssemblies.twoPad_concentrated_upper (ext : LinearAssemblies.Probability.FiniteAbsorptionLaw)
  (sub : LinearAssemblies.Probability.SubexponentialEquivalence) (bern : LinearAssemblies.Probability.BernsteinLaw) :
  ∃ C,
    0 < C ∧
      ∀ (N : ℕ) (ε δ : ℝ),
        2 ≤ N →
          0 < ε →
            ε ≤ 1 / 2 →
              0 < δ →
                δ ≤ 1 / 2 →
                  ∃ b,
                    b.block.p.system.Concentrated LinearAssemblies.twoPad (↑N) ε δ ∧
                      b.block.p.system.Concentrated (LinearAssemblies.twoPadFlexibleRule b.First b.Second).binds (↑N) ε
                          δ ∧
                        ↑b.block.cost ≤
                          C * ↑(LinearAssemblies.Concentration.budgetR N ε δ) *
                            LinearAssemblies.phi (↑N / ↑(LinearAssemblies.Concentration.budgetR N ε δ))
